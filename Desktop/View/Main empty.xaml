<Page x:Class="Desktop.View.Main_empty"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Desktop"
      mc:Ignorable="d" 

      Title="Main_empty" Height="600" Width="800" 
      Background="White" >

    
    <Grid>
        <Label x:Name="NickName" Width="145" Content="Имя пользователя" HorizontalAlignment="Left" Margin="10,126,0,0" FontSize="15" HorizontalContentAlignment="Left" VerticalAlignment="Top"/>

        <Image Margin="10,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Source="/Ava.png" 
        Stretch="Fill" Width="110" Height="110.10" MouseLeftButtonDown="ClickImage" />
        <Button Style="{StaticResource RoundBut10}" Margin="0,170,0,0" FontSize="25"  Height="50" Width=" 300"
         Content="Создать первую задачу" Click="Button_Click"                                                                 />
        <Label Content="Добро пожаловать!" HorizontalAlignment="Center" Margin="0,110,120,0" VerticalAlignment="Top" FontSize="34" />
        <Label Content="Создайте свою первую &#xD;&#xA;задачу!" HorizontalAlignment="Center" Margin="0,170,60,0" VerticalAlignment="Top" FontSize="34" />
        <Popup x:Name="popup" Placement="Left" AllowsTransparency="True">
            <Border Background="White" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="10">
                <StackPanel>
                    <Button Content="Сменить изображение профиля" Click="ChangeProfileImage_Click" />
                    <Button Content="Выйти" Click="Logout_Click" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Page>
