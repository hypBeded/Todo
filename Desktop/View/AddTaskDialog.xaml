<Page x:Class="Desktop.View.AddTaskDialog"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Desktop.View"
      mc:Ignorable="d" 
      Title="AddTaskDialog" Height="300" Width="420" 
      Background="White" >

    <Grid>
        <Label Content="Название" HorizontalAlignment="Left" Margin="30,25,0,0" VerticalAlignment="Top"/>
        <Label Content="Категория" HorizontalAlignment="Left" Margin="30,80,0,0" VerticalAlignment="Top"/>
        <Label Content="Описание" HorizontalAlignment="Left" Margin="30,133,0,0" VerticalAlignment="Top"/>

        <DatePicker x:Name="DTP" HorizontalAlignment="Left" Margin="225,81,0,0" VerticalAlignment="Top" Height="23" Width="165"/>

        <TextBox x:Name="Name" Style="{DynamicResource BorderRadius}" Height="24" Width="160"  HorizontalAlignment="Left" Margin="30,51,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" />
        <ComboBox  x:Name="Category"  Height="24" Width="160"   HorizontalAlignment="Left" Margin="30,109,0,0"  VerticalAlignment="Top" SelectionChanged="Category_SelectionChanged" >
            <!-- Style="{DynamicResource ComboBoxRad}" -->
            <ComboBoxItem Content="Дом" Tag="Home"/>
            <ComboBoxItem Content="Работа" Tag="Work"/>
            <ComboBoxItem Content="Учеба" Tag="Study"/>
            <ComboBoxItem Content="Отдых" Tag="Leisure"/>
        </ComboBox>
        <TextBox x:Name="Description" Style="{DynamicResource BorderRadius}" Height="51" Width="160"  HorizontalAlignment="Left" Margin="30,159,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" />
        <Button Style="{DynamicResource RoundBut6}" Foreground="White" Background="Green" BorderBrush="LightGray" Content="Создать" HorizontalAlignment="Left" Margin="30,225,0,0" VerticalAlignment="Top" Width="170" Height="20" Click="Button_Click" />
        <Button Style="{DynamicResource RoundBut6}" Foreground="White" Background="#F96033" BorderBrush="LightGray" Content="Отмена" HorizontalAlignment="Left" Margin="225,225,0,0" VerticalAlignment="Top" Width="170" Height="20"/>
    </Grid>
</Page>
