<Page x:Class="Desktop.View.Main"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Desktop"
      mc:Ignorable="d" 
      Title="Main" Height="600" Width="800" 
      Background="White"    >
    
    <Page.Resources>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </Page.Resources>

    <Grid>
        <Button Style="{DynamicResource crug}" Height="80" Width="80" 
 HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="30,0,0,70" Click="AddTask"    >
            <TextBlock Text="+" FontSize="60" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="3,0,0,9" Foreground="White" />
        </Button>

        <Image Margin="10,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Source="/Ava.png" 
      Stretch="Fill" Width="110" Height="110.10" />
        <Popup x:Name="popup" Placement="Left" AllowsTransparency="True">
            <Border Background="White" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="10">
                <StackPanel>
                    <Button Content="Сменить изображение профиля" />
                    <Button Content="Выйти"  />
                </StackPanel>
            </Border>
        </Popup>
        <Label x:Name="NickName" Width="145" Content="Имя пользователя" HorizontalAlignment="Left" Margin="10,126,0,0" FontSize="15" HorizontalContentAlignment="Left" VerticalAlignment="Top"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="160,56,0,0">
            <Button Content="Дом" Foreground="LightGreen" Height="40" Width="70" Background="White" FontSize="18" Margin="10,0,4,0"  BorderBrush="White" Click="HomeClick"    />
            <Button Content="Работа" Foreground="Orange" Height="40" Width="70" Background="White" FontSize="18" Margin="10,0,4,0" BorderBrush="White" Click="WorkClick"    />
            <Button Content="Учеба" Foreground="Blue" Height="40" Width="70" Background="White" FontSize="18" Margin="10,0,4,0" BorderBrush="White" Click="StudyClick"  />
            <Button Content="Отдых" Foreground="Purple" Height="40" Width="70" Background="White" FontSize="18" Margin="10,0,4,0"   BorderBrush="White" Click="OtdixClick"  />
        </StackPanel>

        <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top" 
     Height="452" Width="330" Background="AliceBlue" Margin="160,100,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Height="452" Width="330">
                <ListView x:Name="TasksListView" SelectionChanged="TasksListView_SelectionChanged_1">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="5">

                                <CheckBox IsChecked="{Binding Status}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" 
                        FontWeight="Bold" 
                        HorizontalAlignment="Left"/>
                                    <TextBlock Text="{Binding TimeDisplay}" 
                        FontSize="10" 
                        Foreground="Gray"
                        HorizontalAlignment="Left"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </ScrollViewer>
        </StackPanel>

        <Border BorderBrush="Black" BorderThickness="2" Background="White" 
 HorizontalAlignment="Right" Width="250" Height="350" Margin="0,60,20,0"  Visibility="{Binding SelectedTask, Converter={StaticResource NullToVisibilityConverter}}">
            <StackPanel Visibility="{Binding SelectedTask, Converter={StaticResource NullToVisibilityConverter}}">
                <TextBlock HorizontalAlignment="Center" Margin="10,5,0,0" 
                    Text="{Binding SelectedTask.Name}" FontSize="20" FontWeight="Bold"/>
                <TextBlock HorizontalAlignment="Left" Margin="10,20,0,0"
                    Text="{Binding SelectedTask.TimeDisplay}" FontSize="18"/>
                <TextBlock HorizontalAlignment="Left" Margin="10,2,0,0"
                    Text="{Binding SelectedTask.DateDisplay}" FontSize="18"/>
                <TextBlock HorizontalAlignment="Left" Margin="10,15,0,0" 
                    Text="{Binding SelectedTask.Description}" FontSize="18" TextWrapping="Wrap"/>

                <Button x:Name="Compleated" Content="Готово" FontSize="17" Style="{StaticResource RoundBut15}" Margin="0,70,0,0" Width="190" Height="30" Click="Compleated_Click"/>
                <Button x:Name="Del" Content="Удалить" FontSize="17" Style="{StaticResource RoundBut15}" Margin="0,10,0,0" Width="190" Height="30" Click="Del_Click"/>
            </StackPanel>
        </Border>

        <Label Content="Задачи" HorizontalAlignment="Left" Foreground="DarkRed" FontSize="20"  Margin="8,210,0,0" VerticalAlignment="Top" MouseLeftButtonDown="TaskList"/>
        <Label Content="История" HorizontalAlignment="Left" Foreground="DarkRed" FontSize="20"  Margin="8,240,0,0" VerticalAlignment="Top" MouseLeftButtonDown="EndedTasks"/>

    </Grid>
</Page>
