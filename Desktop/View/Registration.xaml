<Page x:Class="Desktop.View.Registration"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Desktop.View"
         mc:Ignorable="d"
         Title="Log in" Height="600" Width="800" 
      Background="White"
     
      >
    <Grid>
        
        <Label Content="Welcome back" FontSize="32         " HorizontalAlignment="Right" Margin="0,66,173,0" VerticalAlignment="Top"/>
        <Label Content="Почта" FontSize ="20"  HorizontalAlignment="Left" Margin="412,199,0,0" VerticalAlignment="Top"/>
        <Label Content="Пароль" FontSize ="20" HorizontalAlignment="Left" Margin="412,280,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="TBEmail" HorizontalAlignment="Left" BorderBrush="White" Margin="412,235,0,0" TextWrapping="Wrap" Text="Введите почту" VerticalAlignment="Top" Width="266" Height="24" 
        FontSize="16" Foreground="Gray" GotFocus="TBEmail_GotFocus" LostFocus="TBEmail_LostFocus"  />
        <TextBox x:Name="TBPassword" HorizontalAlignment="Left" BorderBrush="White" Margin="412,318,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="266" Text="Введите пароль" Height="24" 
        FontSize="15"    Foreground="Gray" GotFocus="TBPassword_GotFocus" LostFocus="TBPassword_LostFocus" />

        <Button Style="{StaticResource RoundBut15}" 
        Content="Зарегистрироваться" HorizontalAlignment="Left" Margin="412,460,0,0" VerticalAlignment="Top" Width="327" Height="37"  BorderBrush="White" FontSize="18 " Click="Registation"/>
        <Button Style="{StaticResource RoundBut15}" 
        Content="Назад" HorizontalAlignment="Left" Margin="412,504,0,0" VerticalAlignment="Top" Width="327" Height="37" BorderBrush="White" FontSize="18 " Click="BackToLogIn" />


        <Label Content="Повторите пароль" FontSize ="20" HorizontalAlignment="Left" Margin="412,358,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="TBRepeatPassword" HorizontalAlignment="Left" BorderBrush="White" Margin="412,396,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="266" Text="Повторите пароль" Height="24" 
FontSize="15"    Foreground="Gray" GotFocus="TBRepeatPassword_GotFocus" LostFocus="TBRepeatPassword_LostFocus" />

        <Label Content="Имя пользователя" FontSize ="20" HorizontalAlignment="Left" Margin="412,126,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="TBUserName" HorizontalAlignment="Left" BorderBrush="White" Margin="412,164,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="266" Text="Введите имя пользователя" Height="24" 
FontSize="15"    Foreground="Gray" GotFocus="TBUserName_GotFocus" LostFocus="TBUserName_LostFocus"/>
        <Image Margin="60,66,462,254" Source="/logo.png" Stretch="Fill"/>
    </Grid>
</Page>
