<Window x:Class="Desktop.Main"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Desktop"
        mc:Ignorable="d"
        Title="Main" Height="600" Width="800" ResizeMode="NoResize">

    <Window.Resources>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <Style x:Key="FocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="2" StrokeDashArray="1 2" Stroke="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" SnapsToDevicePixels="true" StrokeThickness="1"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <SolidColorBrush x:Key="Button.Static.Background" Color="#FFDDDDDD"/>
        <SolidColorBrush x:Key="Button.Static.Border" Color="#FF707070"/>
        <SolidColorBrush x:Key="Button.MouseOver.Background" Color="#FFBEE6FD"/>
        <SolidColorBrush x:Key="Button.MouseOver.Border" Color="#FF3C7FB1"/>
        <SolidColorBrush x:Key="Button.Pressed.Background" Color="#FFC4E5F6"/>
        <SolidColorBrush x:Key="Button.Pressed.Border" Color="#FF2C628B"/>
        <SolidColorBrush x:Key="Button.Disabled.Background" Color="#FFF4F4F4"/>
        <SolidColorBrush x:Key="Button.Disabled.Border" Color="#FFADB2B5"/>
        <SolidColorBrush x:Key="Button.Disabled.Foreground" Color="#FF838383"/>
        <Style x:Key="crug" TargetType="{x:Type Button}">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
            <Setter Property="Background" Value="{StaticResource Button.Static.Background}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Button.Static.Border}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" CornerRadius="60" Background="#F96060" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="true">

                            <ContentPresenter x:Name="contentPresenter" Focusable="False" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDefaulted" Value="true">
                                <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="Background" TargetName="border" Value="{StaticResource Button.MouseOver.Background}"/>
                                <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource Button.MouseOver.Border}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="true">
                                <Setter Property="Background" TargetName="border" Value="{StaticResource Button.Pressed.Background}"/>
                                <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource Button.Pressed.Border}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Background" TargetName="border" Value="{StaticResource Button.Disabled.Background}"/>
                                <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource Button.Disabled.Border}"/>
                                <Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{StaticResource Button.Disabled.Foreground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Button Style="{DynamicResource crug}" Height="80" Width="80" 
        HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="30,0,0,70" Click="AddTask"    >
            <TextBlock Text="+" FontSize="60" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="3,0,0,9" Foreground="White" />
        </Button>



        <Image Margin="10,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Source="/Ava.png" 
             Stretch="Fill" Width="110" Height="110.10" />
        <Popup x:Name="popup" Placement="Left" AllowsTransparency="True">
            <Border Background="White" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="10">
                <StackPanel>
                    <Button Content="Сменить изображение профиля" />
                    <Button Content="Выйти"  />
                </StackPanel>
            </Border>
        </Popup>
        <Label x:Name="NickName" Width="145" Content="Имя пользователя" HorizontalAlignment="Left" Margin="10,126,0,0" FontSize="15" HorizontalContentAlignment="Left" VerticalAlignment="Top"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="160,56,0,0">
            <Button Content="Дом" Foreground="LightGreen" Height="40" Width="70" Background="White" FontSize="18" Margin="10,0,4,0"  BorderBrush="White" Click="HomeClick"    />
            <Button Content="Работа" Foreground="Orange" Height="40" Width="70" Background="White" FontSize="18" Margin="10,0,4,0" BorderBrush="White" Click="WorkClick"    />
            <Button Content="Учеба" Foreground="Blue" Height="40" Width="70" Background="White" FontSize="18" Margin="10,0,4,0" BorderBrush="White" Click="StudyClick"  />
            <Button Content="Отдых" Foreground="Purple" Height="40" Width="70" Background="White" FontSize="18" Margin="10,0,4,0"   BorderBrush="White" Click="OtdixClick"  />
        </StackPanel>

        <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top" 
            Height="452" Width="330" Background="AliceBlue" Margin="160,100,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Height="452" Width="330">
                <ListView x:Name="TasksListView" SelectionChanged="TasksListView_SelectionChanged_1">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="5">
                                <!-- Чекбокс слева -->
                                <CheckBox IsChecked="{Binding Status}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                <!-- Контент справа -->
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" 
                               FontWeight="Bold" 
                               HorizontalAlignment="Left"/>
                                    <TextBlock Text="{Binding TimeDisplay}" 
                               FontSize="10" 
                               Foreground="Gray"
                               HorizontalAlignment="Left"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </ScrollViewer>
        </StackPanel>


        <Border BorderBrush="Black" BorderThickness="2" Background="White" 
        HorizontalAlignment="Right" Width="250" Height="350" Margin="0,60,20,0"  Visibility="{Binding SelectedTask, Converter={StaticResource NullToVisibilityConverter}}">
            <StackPanel Visibility="{Binding SelectedTask, Converter={StaticResource NullToVisibilityConverter}}">
                <TextBlock HorizontalAlignment="Center" Margin="10,5,0,0" 
                           Text="{Binding SelectedTask.Name}" FontSize="20" FontWeight="Bold"/>
                <TextBlock HorizontalAlignment="Left" Margin="10,20,0,0"
                           Text="{Binding SelectedTask.TimeDisplay}" FontSize="18"/>
                <TextBlock HorizontalAlignment="Left" Margin="10,2,0,0"
                           Text="{Binding SelectedTask.DateDisplay}" FontSize="18"/>
                <TextBlock HorizontalAlignment="Left" Margin="10,15,0,0" 
                           Text="{Binding SelectedTask.Description}" FontSize="18" TextWrapping="Wrap"/>

                <Button x:Name="Compleated" Content="Готово" FontSize="17" Style="{StaticResource RoundBut15}" Margin="0,70,0,0" Width="190" Height="30" Click="Compleated_Click"/>
                <Button x:Name="Del" Content="Удалить" FontSize="17" Style="{StaticResource RoundBut15}" Margin="0,10,0,0" Width="190" Height="30" Click="Del_Click"/>
            </StackPanel>
        </Border>

        <Label Content="Задачи" HorizontalAlignment="Left" Foreground="DarkRed" FontSize="20"  Margin="8,210,0,0" VerticalAlignment="Top" MouseLeftButtonDown="TaskList"/>
        <Label Content="История" HorizontalAlignment="Left" Foreground="DarkRed" FontSize="20"  Margin="8,240,0,0" VerticalAlignment="Top" MouseLeftButtonDown="EndedTasks"/>



    </Grid>
</Window>
