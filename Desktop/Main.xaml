<Window x:Class="Desktop.Main"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Desktop"
        mc:Ignorable="d"
         Title="Main" Height="600" Width="800" ResizeMode="NoResize">
    <Grid>
        <Image Margin="10,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Source="/Ava.png" 
             Stretch="Fill" Width="110" Height="110.10" MouseLeftButtonDown="ClickImage" />
        <Popup x:Name="popup" Placement="Left" AllowsTransparency="True">
            <Border Background="White" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="10">
                <StackPanel>
                    <Button Content="Сменить изображение профиля" Click="ChangeProfileImage_Click" />
                    <Button Content="Выйти" Click="Logout_Click" />
                </StackPanel>
            </Border>
        </Popup>
        <Label x:Name="NickName" Width="140" Content="Имя пользователя" HorizontalAlignment="Left" Margin="10,130,0,0" FontSize="15" HorizontalContentAlignment="Left" VerticalAlignment="Top"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="160,56,0,0">
            <Button Content="Дом" Foreground="LightGreen" Height="40" Width="70" Background="White" FontSize="18" Margin="1,0,0,0"  BorderBrush="White"    />
            <Button Content="Работа" Foreground="Orange" Height="40" Width="70" Background="White" FontSize="18" Margin="1,0,0,0" BorderBrush="White"    />
            <Button Content="Учеба" Foreground="Blue" Height="40" Width="70" Background="White" FontSize="18" Margin="1,0,0,0" BorderBrush="White"  />
            <Button Content="Отдых" Foreground="Purple" Height="40" Width="70" Background="White" FontSize="18" Margin="1,0,0,0"   BorderBrush="White"  />
        </StackPanel>


        <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top" Width="343" Height="452"  Background="AliceBlue" Margin="160,100,0,0">



        </StackPanel>
        <Label Content="Задачи" HorizontalAlignment="Left" Foreground="DarkRed" FontSize="20"  Margin="30,193,0,0" VerticalAlignment="Top"/>
        <Label Content="История" HorizontalAlignment="Left" Foreground="DarkRed" FontSize="20"  Margin="30,240,0,0" VerticalAlignment="Top"/>


    </Grid>
</Window>
